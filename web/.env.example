# Frontend env. Copy to web/.env (gitignored) and fill in. Vite reads env files
# from this directory only, and exposes only VITE_-prefixed vars to client code
# — the repo-root .env the Go server reads is invisible here.

# Required. Same values as NUVIO_BASE_URL and NUVIO_PUBLISHABLE_KEY in the
# repo-root .env: the base URL's origin is the SPA's only cross-origin
# connect-src, so a mismatch blocks login. The publishable key is public
# (https://nuvio.tv/docs#publishable-key).
VITE_NUVIO_BASE_URL=https://api.nuvio.tv
VITE_NUVIO_PUBLISHABLE_KEY=

# Must be byte-identical to DEV_AUTH_BYPASS_TOKEN in the repo-root .env. Nothing
# checks that the two match: a mismatch is rejected as an ordinary 401 and lands
# as a redirect back to /login. Leave empty to hide the dev bypass button. The
# server refuses a token shorter than 32 characters.
VITE_DEV_AUTH_BYPASS_TOKEN=
