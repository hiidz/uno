VAULT_DB=vault.db
PORT=8123
TMDB_KEY_MODE=shared
TMDB_API_KEY=
# TMDB_KEY_MODE=per-account only, with TMDB_API_KEY unset: 32 random bytes, base64
UNO_SECRET=
NUVIO_BASE_URL=https://api.nuvio.tv
NUVIO_PUBLISHABLE_KEY=
SITE_BASE_URL=http://localhost:8123
# Local development only, never on a deployed server. At least 32 characters: openssl rand -hex 16
DEV_AUTH_BYPASS_TOKEN=
UNO_ACCESS=open
UNO_ALLOWED_EMAILS=
# Docker Compose only: the image release to run (e.g. v1.2.0); empty means latest
UNO_TAG=
