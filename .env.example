# Uno reads this file from its working directory at startup (any variable
# already set in the environment wins). compose.yaml passes it to the
# container with env_file. An empty value counts as unset.
# Reference: docs/configuration.md

# --- Required -----------------------------------------------------------

# The public base URL Nuvio's apps reach this server at, with no trailing
# slash. Uno builds every addon manifest URL from it.
SITE_BASE_URL=http://localhost:8123

# Nuvio's publishable API key. It is public: the browser sends it to Nuvio
# with every sign-in.
NUVIO_PUBLISHABLE_KEY=

# A TMDB API key (v3), shared by every account. Required while TMDB_KEY_MODE
# is shared (the default); must be unset when it is per-account.
TMDB_API_KEY=

# --- TMDB key mode ------------------------------------------------------

# shared (default): every account uses TMDB_API_KEY.
# per-account: each Nuvio account saves its own key in the builder.
# TMDB_KEY_MODE=shared

# Required when TMDB_KEY_MODE is per-account: 32 random bytes, base64.
# Generate with: openssl rand -base64 32
# Back it up with the database; the stored keys can't be read without it.
# UNO_SECRET=

# --- Access -------------------------------------------------------------

# open (default): any Nuvio account can sign in.
# allowlist: only the accounts listed in UNO_ALLOWED_EMAILS.
# UNO_ACCESS=open

# Comma-separated email addresses. Required when UNO_ACCESS is allowlist;
# an error when it is open.
# UNO_ALLOWED_EMAILS=you@example.com,friend@example.com

# --- Server -------------------------------------------------------------

# The port the server listens on. compose.yaml publishes 8123, so leave it
# at 8123 when you run the container.
# PORT=8123

# The SQLite database file. compose.yaml overrides it with /data/vault.db.
# VAULT_DB=vault.db

# Nuvio's API base URL. Must be an absolute URL.
# NUVIO_BASE_URL=https://api.nuvio.tv

# --- Docker Compose only ------------------------------------------------

# The image tag compose.yaml runs: a release version without the v
# (1.2.0 for git tag v1.2.0). Defaults to latest.
# UNO_TAG=latest

# --- Local development only ---------------------------------------------

# Never set this on a server other people can reach. Anyone who sends this
# token signs in as a fake account. At least 32 characters.
# Generate with: openssl rand -hex 16
# The Vite dev server reads it from this file too, for the login page's
# bypass button.
# DEV_AUTH_BYPASS_TOKEN=
