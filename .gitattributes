# Go sources are written by gofmt, which always emits LF. Without this, a clone on a
# machine with core.autocrlf=true checks them out as CRLF and `gofmt -l .` then flags
# every file it converted — indistinguishable from a real formatting defect.
*.go    text eol=lf
go.mod  text eol=lf
go.sum  text eol=lf

# The committed docs are edited alongside the Go changes they describe, so they
# get the same treatment — otherwise every docs diff carries a line-ending warning.
*.md    text eol=lf
*.yaml  text eol=lf

# internal/vault/schema.sql is embedded, and SQLite stores its statements as written: LF.
*.sql   text eol=lf

